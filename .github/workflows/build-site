name: Build and Publish Game

# Run on direct pushes to main and on pull request close events (we check merged below)
on:
  push:
    branches: [ main ]
  pull_request:
    types: [ closed ]
 workflow_dispatch: {}   # <-- allows manual runs from the Actions UI

permissions:
  contents: read
  pages: write
  id-token: write

jobs:
  build:
    # Only run the job for a push or for a PR that was merged
    if: "github.event_name == 'push' || (github.event_name == 'pull_request' && github.event.pull_request.merged == true)"
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'

      - name: Install dependencies
        run: npm ci

      - name: Build
        run: npm run build

      - name: Upload Pages artifact
        uses: actions/upload-pages-artifact@v1
        with:
          path: ./dist

  deploy:
    needs: build
    runs-on: ubuntu-latest
    steps:
      - name: Deploy to GitHub Pages
        uses: actions/deploy-pages@v1
